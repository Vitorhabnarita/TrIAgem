# =============================================================================
# .env.example — Copie para .env e ajuste os valores para seu ambiente
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL (asyncpg)
# Formato: postgresql+asyncpg://usuario:senha@host:porta/nome_banco
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://triagem:triagem@localhost:5432/triagem_db

# Pool de conexões
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_NAME="TrIAgem API"
APP_VERSION="0.2.0"
DEBUG=false
AMBIENTE=desenvolvimento
TIMEZONE_CLINICA="America/Sao_Paulo"

# CORS e URLs do Frontend
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
FRONTEND_BASE_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Segurança (RN-004)
# ---------------------------------------------------------------------------
# Gere uma string aleatória com pelo menos 32 caracteres
JWT_SECRET=coloque_uma_chave_secreta_com_pelo_menos_32_caracteres_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Chave mestra para rotas administrativas de onboarding (/admin/*)
ADMIN_API_KEY=coloque_uma_chave_admin_com_pelo_menos_24_caracteres_aqui

# Validade do link único de triagem enviado via WhatsApp (em horas)
TOKEN_TRIAGEM_VALIDADE_HORAS=72

# ---------------------------------------------------------------------------
# Google Gemini (Google AI Studio)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyExemploDeChaveAqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEGUNDOS=45

# ---------------------------------------------------------------------------
# ROI e Regras de Negócio (RN-003)
# ---------------------------------------------------------------------------
ROI_BENCHMARK_MINUTOS=30

# Login 1-click da demonstração comercial (clínica demo do seed). NUNCA ative em produção.
DEMO_LOGIN_HABILITADO=false
